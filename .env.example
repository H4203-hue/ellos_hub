# Valores públicos usados pelo navegador. A anon/publishable key do Supabase
# não é uma chave administrativa; a proteção dos dados depende de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo exclusivo do servidor. Nunca use prefixo NEXT_PUBLIC, nunca envie
# ao navegador e configure separadamente em Development/Preview/Production.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
